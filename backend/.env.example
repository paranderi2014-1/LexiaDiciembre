# --- API central (Plan Maestro §3.1) — sólo servidor ---
DATABASE_URL=postgresql+asyncpg://lexia:lexia@postgres:5432/lexia
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=development

# Firebase Authentication: ID tokens verificados con Firebase Admin SDK.
# FIREBASE_CREDENTIALS acepta la ruta al JSON de la cuenta de servicio o el JSON en línea.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

# Modelos de IA (embeddings 3072 dims -> columna halfvec(3072))
EMBEDDING_MODEL=text-embedding-3-large
CHAT_MODEL=gpt-5

# Orígenes web autorizados (coma separada)
CORS_ORIGINS=http://localhost:3000

# Actualización automática de fuentes oficiales
UPDATE_HOUR=3
UPDATE_TIMEZONE=America/Asuncion
